# ─────────────────────────────────────────────────────────────
#  دستیار هوشمند معلم — نمونه متغیرهای محیطی
#  این فایل هرگز مقدار واقعی ندارد. مقادیر را در .env بگذارید.
#  .env در .gitignore است.
# ─────────────────────────────────────────────────────────────

# ─── پایگاه داده ───
DB_URL=jdbc:postgresql://localhost:5432/smart_teacher
DB_USERNAME=smart_teacher
DB_PASSWORD=changeme

# ─── امنیت ───
# کلید اصلی رمزنگاری Secretها — دقیقاً ۳۲ بایت Base64 (AES-256)
# تولید: bash scripts/generate-keys.sh
# ⚠️ اگر این کلید گم شود، همه API Keyهای ذخیره‌شده قابل بازیابی نیستند.
ENCRYPTION_MASTER_KEY=
# کلید امضای JWT — حداقل ۳۲ بایت تصادفی (Base64)
# تولید: bash scripts/generate-keys.sh
JWT_SECRET=

# ─── ایتا (فاز ۲) ───
# 🔴 نام متغیر مهم است. این‌ها «نام canonical» هستند — با relaxed binding
# Spring در **هر** پروفایلی (dev و prod) کار می‌کنند و به هیچ کلید yml
# اضافه‌ای نیاز ندارند.
#
# ⚠️ صورت‌های کوتاه `EITAA_BOT_TOKEN` / `EITAA_APP_TOKEN` هم پذیرفته
# می‌شوند، ولی فقط چون صریحاً در `application-dev.yml` و
# `application-prod.yml` نگاشت شده‌اند. پیش‌تر این نگاشت در prod نبود و
# همین باعث می‌شد نام کوتاه آنجا بی‌صدا نادیده گرفته شود — پس اگر جایی
# شک کردید، نام canonical را بگذارید.
#
# توکن ربات ایتایار — ارسال به گروه/کانال (https://eitaayar.ir)
APP_EITAA_BOT_TOKEN=
# توکن برنامک — ارسال به کاربر (developer.eitaa.com)
APP_EITAA_APP_TOKEN=
# اعتبارسنجی از راه دور ایتا — پیش‌فرض خاموش
# (HMAC محلی کافی است؛ سرویس ایتا سقف ۲۰ req/s دارد و IP را مسدود می‌کند)
APP_EITAA_REMOTE_VERIFY_ENABLED=false

# ─── حالت Mock (توسعه) ───
APP_MOCK_EITAA=true
APP_MOCK_AI=true
APP_MOCK_PAYMENT=true

# ─── CORS (الزامی برای پروداکشن) ───
# 🔴 پیش‌فرض خالی است، یعنی **هیچ** مبدأیی مجاز نیست (Fail-Closed).
# Mini App داخل WebView ایتا از مبدأیی غیر از API اجرا می‌شود؛ بدون
# پاسخ درست به preflight، مرورگر تماس را هرگز نمی‌فرستد و هیچ ردی هم در
# لاگ سرور نمی‌ماند. چند مبدأ را با کاما جدا کنید.
APP_CORS_ALLOWED_ORIGINS=

# ─── Redis (اختیاری) ───
# true یعنی محدودکننده نرخ و نگه‌بان بازپخش روی Redis (پایدار بین
# راه‌اندازی‌های مجدد). پیش‌فرض false = حافظه‌ای.
APP_REDIS_ENABLED=false

# ─── ذخیره‌سازی فایل ───
APP_STORAGE_PROVIDER=LOCAL
APP_STORAGE_PATH=./data/files

# ─── Mini App (فاز ۲) ───
VITE_API_URL=http://localhost:8080/api/v1
VITE_DEV_INIT_DATA=
