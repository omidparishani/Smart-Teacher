# ─────────────────────────────────────────────────────────────
#  دستیار هوشمند معلم — نمونه متغیرهای محیطی Production
#  ⚠️ هیچ مقدار پیش‌فرضی نباید ناامن باشد.
#  در محیط واقعی، این مقادیر را تکمیل کرده و فایل را به عنوان .env ذخیره کنید.
# ─────────────────────────────────────────────────────────────

# ─── پروفایل فعال ───
SPRING_PROFILES_ACTIVE=prod

# ─── پایگاه داده ───
# در داکر کامپوز، نام سرویس معمولاً postgres است
DB_URL=jdbc:postgresql://postgres:5432/smart_teacher
DB_USERNAME=smart_teacher
DB_PASSWORD=strong_production_password_here

# ─── امنیت ───
# کلید اصلی رمزنگاری Secretها — دقیقاً ۳۲ بایت Base64 (AES-256)
# تولید با: bash scripts/generate-keys.sh
ENCRYPTION_MASTER_KEY=
# کلید امضای JWT — حداقل ۳۲ بایت تصادفی (Base64)
# تولید با: bash scripts/generate-keys.sh
JWT_SECRET=

# ─── ایتا (اتصال واقعی) ───
# نام‌های canonical برای محیط پروداکشن:
APP_EITAA_BOT_TOKEN=
APP_EITAA_APP_TOKEN=
APP_EITAA_REMOTE_VERIFY_ENABLED=false

# ─── حالت Mock (در پروداکشن همیشه false) ───
APP_MOCK_EITAA=false
APP_MOCK_AI=false
APP_MOCK_PAYMENT=false

# ─── CORS (الزامی برای پروداکشن) ───
# 🔴 دامنه‌های مجاز مینی‌اپ و پنل ادمین (جدا شده با کاما)
# توجه: برنامک در WebView ایتا اجرا می‌شود و در صورت نبودن دامنه اینجا مسدود می‌شود.
APP_CORS_ALLOWED_ORIGINS=https://app.yourdomain.ir,https://admin.yourdomain.ir

# ─── Redis (توصیه‌شده برای پروداکشن) ───
APP_REDIS_ENABLED=true
REDIS_HOST=redis
REDIS_PORT=6379

# ─── ذخیره‌سازی فایل ───
APP_STORAGE_PROVIDER=LOCAL
APP_STORAGE_PATH=/app/data/files

# ─── آدرس‌های فرانت‌اند برای ساخت (Build-time) ───
VITE_API_URL=https://api.yourdomain.ir/api/v1
