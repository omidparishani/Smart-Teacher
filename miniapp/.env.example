# ── Mini App — متغیرهای محیطی ────────────────────────────────
# این فایل نمونه است. مقادیر واقعی در .env.local (که Git نمی‌شود).

# نشانی API بک‌اند
VITE_API_URL=http://localhost:8080/api/v1

# 🔴 فقط برای توسعه محلی — هرگز در Production مقدار نگیرد.
# `initData` جعلی که بک‌اند در پروفایل dev با app.mock.eitaa=true می‌پذیرد.
# ⚠️ اگر این مقدار در بیلد Production بماند، یک دروازه ورود جعلی می‌شود.
VITE_DEV_INIT_DATA=
